# Copy to .env locally and replace these placeholders. Never commit .env.
# Windows launcher: pass --env-file .env; other launchers require environment exports.
SOC_TELEGRAM_BOT_TOKEN='replace-with-your-bot-token'
SOC_TELEGRAM_CHAT_ID='replace-with-your-private-chat-id'
# Optional: defaults to CHAT_ID and must identify the same private-chat owner.
SOC_TELEGRAM_USER_ID='replace-with-your-private-chat-id'
